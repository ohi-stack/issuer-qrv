{
  "environment": "qrv-production-v1",
  "monitors": [
    {
      "name": "marketing-root",
      "url": "https://qrv.network",
      "intervalSeconds": 120,
      "expectedStatus": 200
    },
    {
      "name": "registry-health",
      "url": "https://registry.qrv.network/health",
      "intervalSeconds": 60,
      "expectedStatus": 200
    },
    {
      "name": "api-health",
      "url": "https://api.qrv.network/health",
      "intervalSeconds": 60,
      "expectedStatus": 200
    },
    {
      "name": "issuer-dashboard",
      "url": "https://issuer.qrv.network/dashboard",
      "intervalSeconds": 120,
      "expectedStatus": 200
    },
    {
      "name": "verify-demo-verified",
      "url": "https://verify.qrv.network/verify/QRV-PROD-CERT-000001",
      "intervalSeconds": 60,
      "expectedStatus": 200,
      "expectedBodyContains": "VERIFIED"
    },
    {
      "name": "verify-demo-revoked",
      "url": "https://verify.qrv.network/verify/QRV-PROD-CERT-000002",
      "intervalSeconds": 60,
      "expectedStatus": 200,
      "expectedBodyContains": "REVOKED"
    }
  ]
}
