# QR-V Issuer Portal production configuration
NODE_ENV=production
PORT=3001
APP_VERSION=1.1.0
TZ=UTC
LOG_LEVEL=info

# Public service URLs
APP_BASE_URL=https://issuer.qrv.network
ISSUER_BASE_URL=https://issuer.qrv.network
VERIFY_BASE_URL=https://verify.qrv.network
REGISTRY_BASE_URL=https://registry.qrv.network
API_BASE_URL=https://api.qrv.network
ROOT_BASE_URL=https://qrv.network

# Required for issuer-to-registry writes. Must match registry REGISTRY_API_KEY or a permitted issuer key.
ISSUER_API_KEY=replace-with-long-random-issuer-write-key
REGISTRY_API_KEY=replace-with-long-random-registry-write-key

# Default issuer form values
DEFAULT_ISSUER_NAME=QR-V Demo Issuer
DEFAULT_RECORD_PREFIX=QRV-CERT

# Runtime tuning
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
CORS_ALLOWED_ORIGINS=https://qrv.network,https://issuer.qrv.network,https://verify.qrv.network

# Optional billing placeholders retained for issuer/payment integrations. Do not commit real secrets.
STRIPE_SECRET_KEY=sk_live_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_PRICE_STARTER=price_replace_starter_199
STRIPE_PRICE_GROWTH=price_replace_growth_499
STRIPE_PRICE_PROFESSIONAL=price_replace_professional_1500
STRIPE_PRICE_ENTERPRISE=price_replace_enterprise_5000
STRIPE_SUCCESS_URL=https://issuer.qrv.network/billing/success?session_id={CHECKOUT_SESSION_ID}
STRIPE_CANCEL_URL=https://issuer.qrv.network/billing/cancel
